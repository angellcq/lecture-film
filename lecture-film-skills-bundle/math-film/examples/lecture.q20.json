  "math": [
    {
      "label": "半径6的圆面积 36π",
      "expr": "pi*6**2",
      "expect": "36*pi"
    },
    {
      "label": "45°扇形 = 1/8 圆 = 9π/2",
      "expr": "pi*6**2/8",
      "expect": "Rational(9,2)*pi"
    },
    {
      "label": "等腰直角三角形直角边 = 3√2",
      "expr": "sqrt(Rational(6**2,2))",
      "expect": "3*sqrt(2)"
    },
    {
      "label": "三角形 ACD 面积 = 9",
      "expr": "Rational(1,2)*(3*sqrt(2))**2",
      "expect": "9"
    },
    {
      "label": "阴影 = 9π/2 − 9 = 9(π/2−1) ≈ 5.14",
      "expr": "Rational(9,2)*pi - 9",
      "expect": "9*(pi/2-1)"
    },
    {
      "label": "数值核对：9(π/2−1) 保留两位 = 5.14",
      "expr": "round(N(9*(pi/2-1))*100)",
      "expect": "514"
    }
  ]
}